theme_override_fonts/normal_font = ExtResource("3_16cc3")
theme_override_font_sizes/normal_font_size = 34
bbcode_enabled = true
text = "[center]Tutorial[/center]
You have a variety of stats that represent your power level shown at the top of the screen.
[color=#992211]HP[/color] is your health when they reach 0 you will die and repeat the loop again. 
[color=#000099]Armor[/color] reduces the damage you take.
[color=#119911]Speed[/color] determines who goes first, and if you sufficiently outspeed the enemy you will get bonus attacks.
The rest you'll figure out for yourself.
[center]Press the Interact key (E/Enter) to continue.[/center]"
scroll_active = false

