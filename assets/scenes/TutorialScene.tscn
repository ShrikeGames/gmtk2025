bbcode_enabled = true
text = "[center]Tutorial[/center]
You are the Golden Knight:

You must prepare yourself to defeat the boss by exploring the land and collecting chests        , defeating minions        of the boss, and powering yourself up.

Potions are permanent, but all but 1 item will be lost upon death or victory against the boss.
[center]Press the Interact key (E/Enter) to continue.[/center]"
scroll_active = false

